[Unit]
Description=Kamstrup M-Bus to MQTT
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=kamstrup
Group=kamstrup
WorkingDirectory=/opt/mbus
ExecStart=/opt/mbus/run.sh
Restart=always
RestartSec=3

# Serial permissions (alternativ: User in dialout/tty Gruppe)
# SupplementaryGroups=dialout

# Logs in journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
